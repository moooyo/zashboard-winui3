<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Zashboard.App.Controls.TrafficIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.HelpText="Live value updates are visual and are not announced automatically."
    AutomationProperties.LiveSetting="Off"
    AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
    d:DesignHeight="64"
    d:DesignWidth="220"
    mc:Ignorable="d">

    <Grid MinWidth="160">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            AutomationProperties.AccessibilityView="Raw"
            Background="{x:Bind AccentBrush, Mode=OneWay}"
            CornerRadius="2" />
        <StackPanel Grid.Column="2" Spacing="2">
            <TextBlock
                Style="{StaticResource InlineMetricLabelStyle}"
                Text="{x:Bind Label, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.LiveSetting="Off"
                Style="{StaticResource InlineMetricValueStyle}"
                Text="{x:Bind Value, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource InlineMetricLabelStyle}"
                Text="{x:Bind SecondaryValue, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
