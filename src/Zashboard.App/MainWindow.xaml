<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zashboard.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Zashboard.App.Views">

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="OpaqueFallbackBackground"
            Grid.RowSpan="2"
            Background="{ThemeResource WindowFallbackBackgroundBrush}"
            IsHitTestVisible="False" />

        <TitleBar
            x:Name="AppTitleBar"
            Title="Zashboard"
            Subtitle="Clash control center" />

        <views:ShellPage
            x:Name="Shell"
            Grid.Row="1" />
    </Grid>
</Window>
