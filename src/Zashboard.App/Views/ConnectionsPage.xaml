<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zashboard.App.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Zashboard.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="768"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Invoked="OnFocusSearchAccelerator"
            Key="F"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style
            x:Key="ConnectionsListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootLayout" Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Title="Connections"
            Subtitle="Inspect live traffic and close individual sessions." />

        <CommandBar
            Grid.Row="1"
            Margin="-12,8,-12,0"
            Style="{StaticResource SubtleCommandBarStyle}">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <AutoSuggestBox
                        x:Name="ConnectionSearchBox"
                        Width="260"
                        AccessKey="S"
                        AutomationProperties.AcceleratorKey="Control+F"
                        AutomationProperties.HelpText="Search host, process name or path, matched rule or payload, and proxy chain. Press Control+F to focus this field."
                        AutomationProperties.Name="Search connections"
                        PlaceholderText="Search connections"
                        TabIndex="0"
                        TextChanged="OnSearchTextChanged"
                        ToolTipService.ToolTip="Search host, process, path, rule, payload, or proxy chain"
                        UseSystemFocusVisuals="True">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Find" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <TextBlock
                        x:Name="ConnectionStatusText"
                        MaxWidth="220"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton
                x:Name="ShowLatestButton"
                AccessKey="R"
                AutomationProperties.HelpText="Resume live connection updates and replace the paused snapshot with the latest data."
                AutomationProperties.Name="Show latest connections"
                Click="OnRefreshClicked"
                IsEnabled="False"
                Label="Show latest"
                TabIndex="1"
                ToolTipService.ToolTip="Resume updates and show the latest streamed snapshot">
                <AppBarButton.Icon>
                    <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Refresh" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarToggleButton
                x:Name="PauseUpdatesButton"
                AccessKey="P"
                AutomationProperties.HelpText="Freeze the current connection snapshot. Closing and blocking are disabled until live updates resume."
                AutomationProperties.Name="Pause connection updates"
                Checked="OnPauseToggled"
                Label="Pause"
                TabIndex="2"
                ToolTipService.ToolTip="Pause incoming connection updates"
                Unchecked="OnPauseToggled">
                <AppBarToggleButton.Icon>
                    <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Pause" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton
                x:Name="CloseAllConnectionsButton"
                AccessKey="A"
                AutomationProperties.HelpText="Close every active connection, including connections hidden by the current search."
                AutomationProperties.Name="Close all active connections"
                Click="OnDisconnectAllClicked"
                IsEnabled="False"
                Label="Close all"
                TabIndex="3"
                ToolTipService.ToolTip="Close all active connections">
                <AppBarButton.Icon>
                    <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Clear" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar
            x:Name="ConnectionsInfoBar"
            Grid.Row="2"
            Margin="0,8,0,0"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="True"
            IsOpen="False" />

        <Grid
            x:Name="MasterDetailGrid"
            Grid.Row="4"
            SizeChanged="OnMasterDetailSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ConnectionsColumn" Width="*" />
                <ColumnDefinition x:Name="PaneGutterColumn" Width="12" />
                <ColumnDefinition x:Name="DetailsColumn" Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                x:Name="ConnectionsPane"
                Style="{StaticResource DataPaneBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Padding="16,8"
                        AutomationProperties.AccessibilityView="Raw"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="82" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level3"
                            Style="{StaticResource InlineMetricLabelStyle}"
                            Text="Host" />
                        <TextBlock
                            Grid.Column="1"
                            AutomationProperties.HeadingLevel="Level3"
                            AutomationProperties.Name="Download rate"
                            Style="{StaticResource InlineMetricLabelStyle}"
                            Text="Down/s"
                            TextAlignment="Right" />
                        <TextBlock
                            Grid.Column="2"
                            AutomationProperties.HeadingLevel="Level3"
                            AutomationProperties.Name="Upload rate"
                            Style="{StaticResource InlineMetricLabelStyle}"
                            Text="Up/s"
                            TextAlignment="Right" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="ConnectionsList"
                            AutomationProperties.HelpText="Select a connection to inspect its route and counters. Activate a row to open details in compact view."
                            AutomationProperties.LiveSetting="Off"
                            AutomationProperties.Name="Active connections"
                            IsItemClickEnabled="True"
                            ItemClick="OnConnectionItemClick"
                            ItemContainerStyle="{StaticResource ConnectionsListViewItemStyle}"
                            ItemsSource="{x:Bind Connections, Mode=OneWay}"
                            SelectionChanged="OnConnectionSelectionChanged"
                            Style="{StaticResource DataListViewStyle}"
                            TabIndex="4"
                            UseSystemFocusVisuals="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="controls:ConnectionDisplayItem">
                                    <Grid
                                        Padding="16,9"
                                        AutomationProperties.AccessibilityView="Content"
                                        AutomationProperties.Name="{x:Bind AccessibleDescription, Mode=OneWay}"
                                        ColumnSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="82" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Host, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource DownloadAccentBrush}"
                                            Text="{x:Bind Download, Mode=OneWay}"
                                            TextAlignment="Right"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Foreground="{ThemeResource UploadAccentBrush}"
                                            Text="{x:Bind Upload, Mode=OneWay}"
                                            TextAlignment="Right"
                                            TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Network:" />
                                            <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Network, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Rule:" />
                                            <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Rule, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <controls:EmptyState
                            x:Name="ConnectionsEmptyState"
                            Description="Active sessions will appear when the connection stream is available."
                            IconGlyph="&#xE968;"
                            StateTitle="No active connections" />
                    </Grid>
                </Grid>
            </Border>

            <Border
                x:Name="ConnectionDetailsPane"
                Grid.Column="2"
                AutomationProperties.Name="Connection details"
                Style="{StaticResource DataPaneBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="CompactDetailsHeader"
                        Padding="10,8"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        ColumnSpacing="8"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="CompactDetailsBackButton"
                            AutomationProperties.HelpText="Return to the connection list."
                            AutomationProperties.Name="Back to connections"
                            Click="OnCompactDetailsBackClicked"
                            TabIndex="5"
                            ToolTipService.ToolTip="Back to connections"
                            UseSystemFocusVisuals="True">
                            <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Back" />
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level2"
                            FontWeight="SemiBold"
                            Text="Connection details" />
                    </Grid>
                    <controls:EmptyState
                        x:Name="ConnectionDetailsEmptyState"
                        Grid.Row="1"
                        Description="Choose a connection to inspect its route and counters."
                        IconGlyph="&#xE8A7;"
                        StateTitle="No connection selected" />
                    <Grid
                        x:Name="ConnectionDetailsContent"
                        Grid.Row="1"
                        Padding="18"
                        RowSpacing="12"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer
                            x:Name="ConnectionDetailsScrollViewer"
                            AutomationProperties.Name="Selected connection information"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    x:Name="DetailHostText"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource SectionTitleTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource InlineMetricLabelStyle}" Text="Network" />
                                    <TextBlock x:Name="DetailNetworkText" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource InlineMetricLabelStyle}" Text="Matched rule" />
                                    <TextBlock x:Name="DetailRuleText" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource InlineMetricLabelStyle}" Text="Proxy chain" />
                                    <TextBlock x:Name="DetailChainText" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource InlineMetricLabelStyle}" Text="Started" />
                                    <TextBlock x:Name="DetailStartedText" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource InlineMetricLabelStyle}" Text="Download" />
                                        <TextBlock x:Name="DetailDownloadText" Foreground="{ThemeResource DownloadAccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Style="{StaticResource InlineMetricLabelStyle}" Text="Upload" />
                                        <TextBlock x:Name="DetailUploadText" Foreground="{ThemeResource UploadAccentBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="BlockActionColumn" Width="0" />
                                <ColumnDefinition x:Name="BlockActionGutterColumn" Width="0" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="BlockConnectionButton"
                                HorizontalAlignment="Stretch"
                                AccessKey="B"
                                AutomationProperties.HelpText="Block this connection in the Smart core."
                                AutomationProperties.Name="Block selected connection"
                                Click="OnBlockSelectedClicked"
                                Content="Block"
                                IsEnabled="False"
                                TabIndex="6"
                                ToolTipService.ToolTip="Block this connection in the Smart core"
                                UseSystemFocusVisuals="True"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="DisconnectSelectedButton"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                AccessKey="C"
                                AutomationProperties.HelpText="Close the selected active connection. This action is unavailable for a paused or stale snapshot."
                                AutomationProperties.Name="Close selected connection"
                                Click="OnDisconnectSelectedClicked"
                                Content="Close connection"
                                IsEnabled="False"
                                TabIndex="7"
                                ToolTipService.ToolTip="Close the selected active connection"
                                UseSystemFocusVisuals="True" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
