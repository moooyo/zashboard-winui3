<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zashboard.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Zashboard.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="768"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Invoked="OnFocusSearchAccelerator"
            Key="F"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style
            x:Key="AlignedDataListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Title="Rules"
            Subtitle="Browse the active routing policy in evaluation order." />

        <CommandBar
            Grid.Row="1"
            Margin="-12,8,-12,0"
            Style="{StaticResource SubtleCommandBarStyle}">
            <CommandBar.Content>
                <StackPanel
                    x:Name="RuleQueryControls"
                    Orientation="Horizontal"
                    Spacing="8">
                    <AutoSuggestBox
                        x:Name="RuleSearchBox"
                        Width="260"
                        AccessKey="S"
                        AutomationProperties.AcceleratorKey="Control+F"
                        AutomationProperties.HelpText="Filter routing rules by type, payload, target, or identifier. Press Control+F to focus this field."
                        AutomationProperties.Name="Search rules"
                        PlaceholderText="Search rules"
                        TabIndex="0"
                        TextChanged="OnRuleSearchTextChanged"
                        UseSystemFocusVisuals="True">
                        <AutoSuggestBox.QueryIcon>
                            <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Find" />
                        </AutoSuggestBox.QueryIcon>
                    </AutoSuggestBox>
                    <ComboBox
                        x:Name="RuleFilterBox"
                        Width="160"
                        AccessKey="T"
                        AutomationProperties.HelpText="Show all routing rules or only rules in the selected type category."
                        AutomationProperties.Name="Rule type filter"
                        SelectedIndex="0"
                        SelectionChanged="OnRuleFilterChanged"
                        TabIndex="1"
                        UseSystemFocusVisuals="True">
                        <ComboBoxItem Content="All rules" Tag="all" />
                        <ComboBoxItem Content="Domain" Tag="domain" />
                        <ComboBoxItem Content="IP and network" Tag="network" />
                        <ComboBoxItem Content="Process" Tag="process" />
                        <ComboBoxItem Content="Final" Tag="final" />
                    </ComboBox>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton
                x:Name="RefreshRulesButton"
                AccessKey="R"
                AutomationProperties.HelpText="Fetch the current routing rules from the active controller."
                AutomationProperties.Name="Refresh routing rules"
                Click="OnRefreshClicked"
                IsEnabled="False"
                Label="Refresh"
                TabIndex="2"
                ToolTipService.ToolTip="Refresh routing rules"
                UseSystemFocusVisuals="True">
                <AppBarButton.Icon>
                    <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Refresh" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="UpdateRuleProvidersButton"
                AccessKey="U"
                AutomationProperties.HelpText="Ask the active controller to update every rule provider."
                AutomationProperties.Name="Update all rule providers"
                Click="OnUpdateProvidersClicked"
                IsEnabled="False"
                Label="Update providers"
                TabIndex="3"
                ToolTipService.ToolTip="Update all rule providers"
                UseSystemFocusVisuals="True">
                <AppBarButton.Icon>
                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE895;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar
            x:Name="RulesInfoBar"
            Grid.Row="2"
            Margin="0,8,0,0"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="True"
            IsOpen="False" />

        <Pivot
            x:Name="RulesPivot"
            Grid.Row="4"
            AutomationProperties.Name="Routing rules and providers"
            SelectionChanged="OnRulesPivotSelectionChanged">
            <PivotItem Header="Rules">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <Border MinWidth="760" Style="{StaticResource DataPaneBorderStyle}">
                        <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Padding="16,9"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Order" />
                        <TextBlock Grid.Column="1" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Type" />
                        <TextBlock Grid.Column="2" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Payload" />
                        <TextBlock Grid.Column="3" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Target" />
                        <TextBlock Grid.Column="4" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Hits" />
                        <TextBlock Grid.Column="5" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Enabled" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="RulesList"
                            AutomationProperties.HelpText="Activate a routing rule to inspect its complete details."
                            AutomationProperties.Name="Routing rules"
                            IsItemClickEnabled="True"
                            ItemClick="OnRuleItemClick"
                            ItemContainerStyle="{StaticResource AlignedDataListViewItemStyle}"
                            ItemsSource="{x:Bind Rules, Mode=OneWay}"
                            SelectionChanged="OnRuleSelectionChanged"
                            Style="{StaticResource DataListViewStyle}"
                            TabIndex="4"
                            UseSystemFocusVisuals="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="controls:RuleDisplayItem">
                                    <Grid
                                        MinHeight="56"
                                        Padding="16,8"
                                        AutomationProperties.AccessibilityView="Content"
                                        AutomationProperties.ItemStatus="{x:Bind State}"
                                        AutomationProperties.Name="{x:Bind AccessibleDescription}"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Index}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Type}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontFamily="{StaticResource AppMonospaceFontFamily}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Payload}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Text="{x:Bind Proxy}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            Text="{x:Bind HitCount}" />
                                        <controls:UserOperationScope Grid.Column="5" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <ToggleButton
                                                Grid.Column="5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                AutomationProperties.HelpText="Turn off to disable this routing rule, or turn on to enable it."
                                                AutomationProperties.Name="{x:Bind ToggleAccessibleName}"
                                                Click="OnRuleToggleClicked"
                                                Content="{x:Bind State}"
                                                IsChecked="{x:Bind Enabled, Mode=OneTime}"
                                                IsEnabled="{x:Bind CanToggle}"
                                                ToolTipService.ToolTip="Enable or disable this routing rule"
                                                UseSystemFocusVisuals="True" />
                                        </controls:UserOperationScope>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <controls:EmptyState
                            x:Name="RulesEmptyState"
                            Description="Routing rules will appear after they are fetched from the controller."
                            IconGlyph="&#xE71D;"
                            StateTitle="No rules loaded" />
                    </Grid>
                            </Grid>
                        </Border>
                    </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Providers">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                <Border MinWidth="760" Style="{StaticResource DataPaneBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid
                            Padding="16,8"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Provider" />
                            <TextBlock Grid.Column="1" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Type" />
                            <TextBlock Grid.Column="2" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Behavior" />
                            <TextBlock Grid.Column="3" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Format" />
                            <TextBlock Grid.Column="4" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Rules" />
                            <TextBlock Grid.Column="5" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Updated" />
                            <TextBlock Grid.Column="6" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource InlineMetricLabelStyle}" Text="Action" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="RuleProvidersList"
                                AutomationProperties.HelpText="Review rule provider metadata or update an individual provider."
                                AutomationProperties.Name="Rule providers"
                                ItemContainerStyle="{StaticResource AlignedDataListViewItemStyle}"
                                ItemsSource="{x:Bind RuleProviders, Mode=OneWay}"
                                SelectionMode="None"
                                Style="{StaticResource DataListViewStyle}"
                                TabIndex="5"
                                UseSystemFocusVisuals="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="controls:RuleProviderDisplayItem">
                                        <Grid
                                            Padding="16,8"
                                            AutomationProperties.AccessibilityView="Content"
                                            AutomationProperties.Name="{x:Bind AccessibleDescription}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock AutomationProperties.AccessibilityView="Raw" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" AutomationProperties.AccessibilityView="Raw" Text="{x:Bind Type}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" AutomationProperties.AccessibilityView="Raw" Text="{x:Bind Behavior}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" AutomationProperties.AccessibilityView="Raw" Text="{x:Bind Format}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" AutomationProperties.AccessibilityView="Raw" Text="{x:Bind RuleCount}" />
                                            <TextBlock Grid.Column="5" AutomationProperties.AccessibilityView="Raw" Text="{x:Bind UpdatedAt}" TextTrimming="CharacterEllipsis" />
                                            <controls:UserOperationScope Grid.Column="6" HorizontalAlignment="Center">
                                                <Button
                                                    Grid.Column="6"
                                                    HorizontalAlignment="Center"
                                                    AutomationProperties.HelpText="Fetch the latest rules from this provider."
                                                    AutomationProperties.Name="{x:Bind UpdateAccessibleName}"
                                                    Click="OnUpdateProviderClicked"
                                                    IsEnabled="{x:Bind CanUpdate}"
                                                    Padding="7"
                                                    Tag="{x:Bind Name}"
                                                    ToolTipService.ToolTip="Update rule provider"
                                                    UseSystemFocusVisuals="True">
                                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE895;" />
                                                </Button>
                                            </controls:UserOperationScope>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <controls:EmptyState
                                x:Name="RuleProvidersEmptyState"
                                Description="Rule providers will appear after the controller responds."
                                IconGlyph="&#xE895;"
                                StateTitle="No rule providers" />
                        </Grid>
                    </Grid>
                </Border>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
