<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zashboard.App.Views.BackendSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Zashboard.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="768"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20,24,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:PageHeader
                Title="Backends"
                Subtitle="Connect to a local or remote Clash-compatible controller." />

            <StackPanel
                Grid.Row="1"
                Margin="0,16,0,0"
                Spacing="8">
                <InfoBar
                    x:Name="ProfileLoadInfoBar"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error"
                    Title="Saved backends could not be loaded">
                    <InfoBar.ActionButton>
                        <Button
                            x:Name="RetryProfilesButton"
                            Click="OnRetryProfilesClicked"
                            Content="Retry loading"
                            UseSystemFocusVisuals="True" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    x:Name="BackendInfoBar"
                    AutomationProperties.LiveSetting="Polite"
                    IsClosable="True"
                    IsOpen="True"
                    Message="Add a controller before using proxies, connections, rules, or live traffic."
                    Severity="Informational"
                    Title="Backend required" />
            </StackPanel>

            <Grid
                Grid.Row="2"
                Margin="0,16,0,0"
                SizeChanged="OnBackendLayoutSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SavedColumn" Width="320" />
                    <ColumnDefinition x:Name="GutterColumn" Width="16" />
                    <ColumnDefinition x:Name="EditorColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SavedRow" Height="520" />
                    <RowDefinition x:Name="EditorGutterRow" Height="0" />
                    <RowDefinition x:Name="EditorRow" Height="0" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="SavedPane"
                    Style="{StaticResource DataPaneBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="SavedBackendsHeading"
                            Margin="16,14,16,10"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextBlockStyle}"
                            Text="Saved backends" />
                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="SavedBackendsList"
                                AutomationProperties.HelpText="Select a saved backend to inspect or edit it. Use Activate to switch controllers."
                                AutomationProperties.LabeledBy="{x:Bind SavedBackendsHeading}"
                                ItemsSource="{x:Bind SavedBackends, Mode=OneWay}"
                                IsTabStop="False"
                                SelectionChanged="OnSavedBackendSelectionChanged"
                                Style="{StaticResource DataListViewStyle}"
                                TabIndex="0"
                                UseSystemFocusVisuals="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="controls:BackendDisplayItem">
                                        <Grid
                                            Padding="12,8"
                                            AutomationProperties.ItemStatus="{x:Bind Status}"
                                            AutomationProperties.Name="{x:Bind AccessibleDescription}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Status}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,3,0,0"
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontFamily="{StaticResource AppMonospaceFontFamily}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Address}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <controls:EmptyState
                                x:Name="SavedBackendsEmptyState"
                                Description="Saved controllers will appear here."
                                IconGlyph="&#xE774;"
                                StateTitle="No saved backends" />
                        </Grid>
                        <CommandBar
                            Grid.Row="2"
                            Style="{StaticResource SubtleCommandBarStyle}">
                            <AppBarButton
                                x:Name="NewBackendButton"
                                AccessKey="N"
                                AutomationProperties.HelpText="Clear the editor to create a backend."
                                Click="OnNewBackendClicked"
                                Label="New"
                                TabIndex="1"
                                ToolTipService.ToolTip="Create a new backend"
                                UseSystemFocusVisuals="True">
                                <AppBarButton.Icon>
                                    <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Add" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="ActivateBackendButton"
                                AccessKey="V"
                                AutomationProperties.HelpText="Activate the selected saved backend."
                                Click="OnActivateBackendClicked"
                                IsEnabled="False"
                                Label="Activate"
                                TabIndex="2"
                                ToolTipService.ToolTip="Activate the selected backend"
                                UseSystemFocusVisuals="True">
                                <AppBarButton.Icon>
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE8E5;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="RemoveBackendButton"
                                AccessKey="R"
                                AutomationProperties.HelpText="Remove the selected saved backend."
                                Click="OnRemoveBackendClicked"
                                IsEnabled="False"
                                Label="Remove"
                                TabIndex="3"
                                ToolTipService.ToolTip="Remove the selected backend"
                                UseSystemFocusVisuals="True">
                                <AppBarButton.Icon>
                                    <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Delete" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                    </Grid>
                </Border>

                <Border
                    x:Name="EditorPane"
                    Grid.Column="2"
                    Padding="20"
                    Style="{StaticResource DataPaneBorderStyle}">
                    <StackPanel MaxWidth="620" Spacing="16">
                        <TextBlock
                            x:Name="ControllerDetailsHeading"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionTitleTextBlockStyle}"
                            Text="Controller details" />
                        <TextBox
                            x:Name="BackendNameBox"
                            AccessKey="A"
                            AutomationProperties.HelpText="Enter an optional friendly name for this backend."
                            AutomationProperties.Name="Backend name"
                            Header="Name"
                            PlaceholderText="Local controller"
                            TabIndex="4"
                            TextChanged="OnEditorInputChanged"
                            UseSystemFocusVisuals="True" />
                        <TextBox
                            x:Name="ControllerAddressBox"
                            AccessKey="D"
                            AutomationProperties.HelpText="Enter an absolute HTTP or HTTPS controller address."
                            AutomationProperties.IsRequiredForForm="True"
                            AutomationProperties.Name="Controller address"
                            Header="Controller address"
                            PlaceholderText="http://127.0.0.1:9090"
                            TabIndex="5"
                            TextChanged="OnEditorInputChanged"
                            UseSystemFocusVisuals="True" />
                        <TextBlock
                            x:Name="ControllerAddressErrorText"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <PasswordBox
                            x:Name="ControllerSecretBox"
                            AccessKey="S"
                            AutomationProperties.HelpText="Enter the optional bearer token. It is encrypted for the current Windows user."
                            AutomationProperties.Name="Controller secret"
                            Header="Secret"
                            PasswordChanged="OnEditorInputChanged"
                            PlaceholderText="Optional bearer token"
                            TabIndex="6"
                            UseSystemFocusVisuals="True" />
                        <InfoBar
                            x:Name="CredentialInfoBar"
                            AutomationProperties.LiveSetting="Polite"
                            IsClosable="False"
                            IsOpen="True"
                            Message="No secret will be saved."
                            Severity="Informational"
                            Title="Credential" />
                        <CheckBox
                            x:Name="ClearSavedSecretCheckBox"
                            AccessKey="L"
                            AutomationProperties.HelpText="Remove the encrypted bearer token when this backend is saved."
                            AutomationProperties.Name="Clear saved controller secret"
                            Checked="OnClearSavedSecretChanged"
                            Content="Remove the saved secret"
                            TabIndex="7"
                            Unchecked="OnClearSavedSecretChanged"
                            UseSystemFocusVisuals="True"
                            Visibility="Collapsed" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Credentials are encrypted for the current Windows user and are never stored with the backend profile."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ConnectButton"
                            AccessKey="C"
                            HorizontalAlignment="Left"
                            AutomationProperties.HelpText="Save these details and connect to the controller."
                            AutomationProperties.Name="Connect to backend"
                            Click="OnConnectClicked"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            TabIndex="8"
                            ToolTipService.ToolTip="Save and connect"
                            UseSystemFocusVisuals="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="16" Glyph="&#xE8E5;" />
                                <TextBlock
                                    x:Name="ConnectButtonText"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Text="Save and connect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
