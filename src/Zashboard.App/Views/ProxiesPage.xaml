<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zashboard.App.Views.ProxiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Zashboard.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="768"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Title="Proxies"
            Subtitle="Inspect proxy groups, test latency, and choose the active route." />

        <CommandBar
            Grid.Row="1"
            Margin="-12,8,-12,0"
            Style="{StaticResource SubtleCommandBarStyle}">
            <AppBarButton
                x:Name="RefreshProxiesButton"
                AutomationProperties.HelpText="Reload proxy groups and providers from the active controller."
                AutomationProperties.Name="Refresh proxies"
                Click="OnRefreshClicked"
                IsEnabled="False"
                Label="Refresh">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Refresh" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="TestAllProxiesButton"
                AutomationProperties.HelpText="Measure latency for every proxy group."
                AutomationProperties.Name="Test all proxy groups"
                Click="OnTestAllClicked"
                IsEnabled="False"
                Label="Test all">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE945;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="UpdateProvidersButton"
                AutomationProperties.HelpText="Request updates for every supported proxy provider."
                AutomationProperties.Name="Update all proxy providers"
                Click="OnUpdateProvidersClicked"
                IsEnabled="False"
                Label="Update providers">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE895;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                x:Name="CheckProvidersButton"
                AutomationProperties.HelpText="Run health checks for every supported proxy provider."
                AutomationProperties.Name="Check all proxy providers"
                Click="OnCheckProvidersClicked"
                IsEnabled="False"
                Label="Check providers">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <InfoBar
            x:Name="ProxyInfoBar"
            Grid.Row="2"
            Margin="0,8,0,0"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="True"
            IsOpen="False" />

        <Pivot Grid.Row="4">
            <PivotItem Header="Groups">
                <Grid>
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater
                            x:Name="ProxyGroupCardsRepeater"
                            AutomationProperties.Name="Proxy groups with inline node selection"
                            ItemsSource="{x:Bind ProxyGroupCards, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsJustification="Start"
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="2"
                                    MinColumnSpacing="12"
                                    MinItemWidth="420"
                                    MinRowSpacing="12"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="controls:ProxyGroupCardDisplayItem">
                                    <Border
                                        Padding="16,14,12,10"
                                        AutomationProperties.Name="{x:Bind AccessibleDescription, Mode=OneWay}"
                                        Style="{StaticResource DataPaneBorderStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        AutomationProperties.HeadingLevel="Level2"
                                                        Style="{StaticResource SectionTitleTextBlockStyle}"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                                    <Border
                                                        Padding="6,2"
                                                        HorizontalAlignment="Left"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        CornerRadius="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock
                                                                AutomationProperties.AccessibilityView="Raw"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind Type, Mode=OneWay}" />
                                                            <TextBlock
                                                                AutomationProperties.AccessibilityView="Raw"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                Text="&#x00B7;" />
                                                            <TextBlock
                                                                AutomationProperties.AccessibilityView="Raw"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind NodeCount, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <Button
                                                        Width="40"
                                                        Height="40"
                                                        Padding="0"
                                                        AutomationProperties.Name="{x:Bind ClearFixedActionName}"
                                                        Click="OnClearFixedProxyClicked"
                                                        IsEnabled="{x:Bind CanClearFixedProxy, Mode=OneWay}"
                                                        Tag="{x:Bind Name}"
                                                        ToolTipService.ToolTip="{x:Bind ClearFixedActionName}"
                                                        UseSystemFocusVisuals="True"
                                                        Visibility="{x:Bind HasFixedProxy, Mode=OneWay}">
                                                        <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Clear" />
                                                    </Button>
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                        Visibility="{x:Bind IsSmart, Mode=OneWay}">
                                                        <Button
                                                            Width="40"
                                                            Height="40"
                                                            Padding="0"
                                                            AutomationProperties.Name="{x:Bind RefreshSmartActionName}"
                                                            Click="OnRefreshSmartWeightsClicked"
                                                            IsEnabled="{x:Bind CanRefreshSmartWeights, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind RefreshSmartActionName}"
                                                            UseSystemFocusVisuals="True">
                                                            <SymbolIcon AutomationProperties.AccessibilityView="Raw" Symbol="Refresh" />
                                                        </Button>
                                                        <Button
                                                            Width="40"
                                                            Height="40"
                                                            Padding="0"
                                                            AutomationProperties.Name="{x:Bind ResetSmartActionName}"
                                                            Click="OnResetSmartWeightsClicked"
                                                            IsEnabled="{x:Bind CanResetSmartWeights, Mode=OneWay}"
                                                            ToolTipService.ToolTip="{x:Bind ResetSmartActionName}"
                                                            UseSystemFocusVisuals="True">
                                                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="15" Glyph="&#xE777;" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="2" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Current" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind SelectedProxy, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind SelectedProxy, Mode=OneWay}" />
                                                <Border
                                                    Grid.Column="2"
                                                    Padding="6,2"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    CornerRadius="3"
                                                    Visibility="{x:Bind HasFixedProxy, Mode=OneWay}">
                                                    <TextBlock
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontSize="11"
                                                        Text="Fixed" />
                                                </Border>
                                            </Grid>

                                            <TextBlock
                                                Grid.Row="3"
                                                Margin="0,4,0,0"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind SmartWeightsStatus, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind SmartWeightsStatus, Mode=OneWay}"
                                                Visibility="{x:Bind IsSmart, Mode=OneWay}" />

                                            <ItemsControl
                                                Grid.Row="5"
                                                ItemsSource="{x:Bind Nodes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid
                                                            ItemHeight="84"
                                                            ItemWidth="192"
                                                            Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="controls:ProxyNodeDisplayItem">
                                                        <Grid
                                                            Width="184"
                                                            Height="78"
                                                            Margin="0,0,8,6"
                                                            AutomationProperties.Name="{x:Bind AccessibleDescription, Mode=OneWay}"
                                                            Background="Transparent"
                                                            RightTapped="OnProxyRightTapped"
                                                            ToolTipService.ToolTip="{x:Bind InteractionHelpText, Mode=OneWay}">
                                                            <ToggleButton
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                VerticalContentAlignment="Stretch"
                                                                Padding="10,7"
                                                                AutomationProperties.HelpText="{x:Bind InteractionHelpText, Mode=OneWay}"
                                                                AutomationProperties.ItemStatus="{x:Bind SelectionStatus, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind SelectActionName, Mode=OneWay}"
                                                                Click="OnSelectProxyClicked"
                                                                IsChecked="{x:Bind IsCurrent, Mode=OneWay}"
                                                                IsEnabled="{x:Bind CanSelect, Mode=OneWay}"
                                                                IsHitTestVisible="{x:Bind CanSelect, Mode=OneWay}"
                                                                UseSystemFocusVisuals="True">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid ColumnSpacing="6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            FontWeight="SemiBold"
                                                                            Text="{x:Bind Name}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            FontSize="11"
                                                                            Text="Current"
                                                                            Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                                                    </Grid>
                                                                    <Grid Grid.Row="1" Margin="0,3,0,0" ColumnSpacing="4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            FontSize="11"
                                                                            Opacity="0.78"
                                                                            Text="{x:Bind Type, Mode=OneWay}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <StackPanel
                                                                            Grid.Column="1"
                                                                            Orientation="Horizontal"
                                                                            Spacing="2"
                                                                            Visibility="{x:Bind ShowSmartMetrics, Mode=OneWay}">
                                                                            <TextBlock AutomationProperties.AccessibilityView="Raw" FontSize="10" Opacity="0.78" Text="R" />
                                                                            <TextBlock AutomationProperties.AccessibilityView="Raw" FontSize="10" Text="{x:Bind Rank, Mode=OneWay}" />
                                                                            <TextBlock AutomationProperties.AccessibilityView="Raw" FontSize="10" Opacity="0.78" Text="W" />
                                                                            <TextBlock AutomationProperties.AccessibilityView="Raw" FontSize="10" Text="{x:Bind Weight, Mode=OneWay}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            AutomationProperties.AccessibilityView="Raw"
                                                                            FontSize="11"
                                                                            Opacity="0.78"
                                                                            Text="{x:Bind Availability, Mode=OneWay}" />
                                                                        <StackPanel
                                                                            Grid.Column="1"
                                                                            Orientation="Horizontal"
                                                                            Spacing="3">
                                                                            <FontIcon
                                                                                AutomationProperties.AccessibilityView="Raw"
                                                                                FontSize="10"
                                                                                Glyph="&#xE945;"
                                                                                Visibility="{x:Bind CanTest, Mode=OneWay}" />
                                                                            <TextBlock
                                                                                AutomationProperties.AccessibilityView="Raw"
                                                                                FontSize="11"
                                                                                Text="{x:Bind Latency, Mode=OneWay}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Grid>
                                                            </ToggleButton>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <controls:EmptyState
                        x:Name="GroupsEmptyState"
                        Description="Proxy groups will appear after the controller responds."
                        IconGlyph="&#xE8AB;"
                        StateTitle="No proxy groups" />
                </Grid>
            </PivotItem>
            <PivotItem Header="Providers">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                <Border MinWidth="960" Style="{StaticResource DataPaneBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource InlineMetricLabelStyle}" Text="Provider" />
                            <TextBlock Grid.Column="1" Style="{StaticResource InlineMetricLabelStyle}" Text="Type" />
                            <TextBlock Grid.Column="2" Style="{StaticResource InlineMetricLabelStyle}" Text="Nodes" />
                            <TextBlock Grid.Column="3" Style="{StaticResource InlineMetricLabelStyle}" Text="Used / total" />
                            <TextBlock Grid.Column="4" Style="{StaticResource InlineMetricLabelStyle}" Text="Expires" />
                            <TextBlock Grid.Column="5" Style="{StaticResource InlineMetricLabelStyle}" Text="Updated" />
                            <TextBlock Grid.Column="6" Style="{StaticResource InlineMetricLabelStyle}" Text="Actions" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="ProvidersList"
                                AutomationProperties.HelpText="Review proxy provider subscription details and run supported provider actions."
                                AutomationProperties.Name="Proxy providers"
                                ItemsSource="{x:Bind Providers, Mode=OneWay}"
                                SelectionMode="None"
                                Style="{StaticResource DataListViewStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="controls:ProxyProviderDisplayItem">
                                        <Grid
                                            Padding="16,8"
                                            AutomationProperties.Name="{x:Bind AccessibleDescription}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="92" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Text="{x:Bind VehicleType}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind VehicleType}" />
                                            <TextBlock Grid.Column="2" AutomationProperties.AccessibilityView="Raw" Text="{x:Bind ProxyCount}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Text="{x:Bind Usage}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Usage}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Text="{x:Bind Expires}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind Expires}" />
                                            <TextBlock
                                                Grid.Column="5"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Text="{x:Bind UpdatedAt}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{x:Bind UpdatedAt}" />
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
                                                <Button
                                                    MinWidth="40"
                                                    MinHeight="40"
                                                    AutomationProperties.HelpText="Request updated subscription data from this provider."
                                                    AutomationProperties.Name="{x:Bind UpdateActionName}"
                                                    Click="OnUpdateProviderClicked"
                                                    IsEnabled="{x:Bind CanUpdate}"
                                                    Padding="0"
                                                    Tag="{x:Bind Name}"
                                                    ToolTipService.ToolTip="{x:Bind UpdateActionName}"
                                                    UseSystemFocusVisuals="True">
                                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE895;" />
                                                </Button>
                                                <Button
                                                    MinWidth="40"
                                                    MinHeight="40"
                                                    AutomationProperties.HelpText="Run the configured health check for this provider."
                                                    AutomationProperties.Name="{x:Bind CheckActionName}"
                                                    Click="OnCheckProviderClicked"
                                                    IsEnabled="{x:Bind CanCheck}"
                                                    Padding="0"
                                                    Tag="{x:Bind Name}"
                                                    ToolTipService.ToolTip="{x:Bind CheckActionName}"
                                                    UseSystemFocusVisuals="True">
                                                    <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE9D9;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <controls:EmptyState
                                x:Name="ProvidersEmptyState"
                                Description="Proxy providers will appear after the controller responds."
                                IconGlyph="&#xE895;"
                                StateTitle="No proxy providers" />
                        </Grid>
                    </Grid>
                </Border>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
