<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Resources/DataColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="AppTextFontFamily">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="AppMonospaceFontFamily">Cascadia Mono</FontFamily>

    <x:Double x:Key="PageHorizontalPadding">24</x:Double>
    <x:Double x:Key="PageVerticalPadding">20</x:Double>
    <x:Double x:Key="ContentSpacing">16</x:Double>
    <x:Double x:Key="CompactContentSpacing">8</x:Double>

    <Style TargetType="Page">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource AppTextFontFamily}" />
    </Style>

    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageSubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style
        x:Key="DataListViewItemStyle"
        BasedOn="{StaticResource DefaultListViewItemStyle}"
        TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="DataListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsItemClickEnabled" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DataListViewItemStyle}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="DataPaneBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="SubtleCommandBarStyle" TargetType="CommandBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="DefaultLabelPosition" Value="Right" />
        <Setter Property="IsOpen" Value="False" />
    </Style>

    <Style x:Key="MonospaceTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonospaceFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="InlineMetricLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style
        x:Key="LogColumnHeaderTextBlockStyle"
        BasedOn="{StaticResource InlineMetricLabelStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="InlineMetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
